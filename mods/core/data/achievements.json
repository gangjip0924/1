    { "id": "a_crit_success_3", "name": "운명의 총아", "desc": "한 생에서 대성공을 3번 이상 거뒀다.", "points": 1, "condition": { "cmp": ["critSuccesses", ">=", 3] } },
    { "id": "a_rank_max", "name": "정점", "desc": "진로 최고 등급에 올랐다.", "points": 2, "condition": { "cmp": ["rank", ">=", 5] } },
    { "id": "a_scenes_8", "name": "이야기꾼", "desc": "한 생에서 장면 8개를 해금했다.", "points": 1, "condition": { "cmp": ["sceneCount", ">=", 8] } },
    { "id": "a_merchant", "name": "상회의 주인", "desc": "상인으로 상회 대표 이상에 올랐다.", "points": 1, "condition": { "all": [{ "career": "merchant" }, { "cmp": ["rank", ">=", 3] }] } },
    { "id": "a_adventurer", "name": "금 등급 모험가", "desc": "모험가로 금 등급 이상에 올랐다.", "points": 1, "condition": { "all": [{ "career": "adventurer" }, { "cmp": ["rank", ">=", 3] }] } },
    { "id": "a_mage", "name": "마탑 교수", "desc": "마도사로 마탑 교수 이상에 올랐다.", "points": 1, "condition": { "all": [{ "career": "mage" }, { "cmp": ["rank", ">=", 3] }] } },
    { "id": "a_dragon", "name": "용의 보물", "desc": "용의 보물산에서 금화를 들고 살아 돌아왔다.", "points": 2 }
