    { "id": "a_short_life", "name": "짧고 굵게", "desc": "40세가 되기 전에 생을 마쳤다. 실패도 이야기다.", "points": 1, "condition": { "all": [{ "flag": "end_death" }, { "cmp": ["age", "<", 40] }] } },
    { "id": "a_bankrupt", "name": "빈털터리", "desc": "빚을 진 채 생을 마쳤다.", "points": 1, "condition": { "cmp": ["gold", "<", 0] } },
